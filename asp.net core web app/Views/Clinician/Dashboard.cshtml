@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@using GrapheneTrace.Web.ViewModels
@model List<PatientSummaryViewModel>

@{
    Layout = null; // remove or change if you have a shared layout
    var clinicianName = Context.Session.GetString("ClinicianName") ?? "Clinician";
    var totalPatients = Model?.Count ?? 0;
    var highRiskCount = Model?.Count(p => string.Equals(p.RiskLevel, "High", StringComparison.OrdinalIgnoreCase) || string.Equals(p.RiskLevel, "Critical", StringComparison.OrdinalIgnoreCase)) ?? 0;
    var activeAlerts = Model?.Sum(p => p.UnacknowledgedAlertCount) ?? 0;
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">My Patients</h2>
            <div class="text-muted">@clinicianName</div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Total Patients</h6>
                    <div class="h4 text-primary">@totalPatients</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">High Risk Count</h6>
                    <div class="h4 text-warning">@highRiskCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Active Alerts</h6>
                    <div class="h4 text-danger">@activeAlerts</div>
                </div>
            </div>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">No patients assigned.</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Patient Name</th>
                                <th>MRN</th>
                                <th>Risk Level</th>
                                <th>Alerts</th>
                                <th>Last Update</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td>
                                        <a href="@Url.Action("PatientDetail", "Clinician", new { id = p.PatientID })">@p.FullName</a>
                                    </td>
                                    <td>@p.MedicalRecordNumber</td>
                                    <td>
                                        @switch(p.RiskLevel?.ToLowerInvariant())
                                        {
                                            case "critical":
                                                <span class="badge" style="background:#dc3545;color:#fff">Critical</span>
                                                break;
                                            case "high":
                                                <span class="badge" style="background:#fd7e14;color:#fff">High</span>
                                                break;
                                            case "medium":
                                                <span class="badge" style="background:#ffc107;color:#212529">Medium</span>
                                                break;
                                            default:
                                                <span class="badge" style="background:#198754;color:#fff">Low</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (p.UnacknowledgedAlertCount > 0)
                                        {
                                            <span class="badge bg-danger">@p.UnacknowledgedAlertCount</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">0</span>
                                        }
                                    </td>
                                    <td>@(p.LastSensorUpdate.HasValue ? p.LastSensorUpdate.Value.ToString("g") : "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
