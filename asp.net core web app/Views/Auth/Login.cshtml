@{
    Layout = null; // use minimal layout for login
}

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>GrapheneTrace - Clinician Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { background: linear-gradient(180deg, #f1f7ff 0%, #ffffff 100%); min-height:100vh; }
        .login-card { max-width: 420px; border-radius: 12px; box-shadow: 0 6px 24px rgba(13,110,253,0.08); border: 1px solid rgba(13,110,253,0.06); }
        .brand { font-weight:700; color:#0d6efd; letter-spacing:0.2px; font-size:1.25rem }
        .form-label { font-weight:600 }
        .card-body { padding: 2rem; }
        .muted-small { color: #6c757d; font-size: .875rem }
    </style>
</head>
<body>
    <div class="d-flex align-items-center justify-content-center" style="min-height:100vh;">
        <div class="card login-card">
            <div class="card-body text-center">
                <div class="mb-3">
                    <svg width="56" height="56" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect x="2" y="3" width="20" height="18" rx="3" fill="#0d6efd" />
                        <path d="M7 9h10M7 13h6" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div class="brand">GrapheneTrace</div>
                <div class="muted-small mb-3">Clinician Portal — Secure Access</div>

                <form asp-controller="Auth" asp-action="Login" method="post" class="text-start">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All" class="text-danger mb-2"></div>

                    <div class="mb-3">
                        <label for="username" class="form-label">Username</label>
                        <input type="text" name="username" id="username" class="form-control form-control-lg" placeholder="username" required autofocus />
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <input type="password" name="password" id="password" class="form-control form-control-lg" placeholder="password" required />
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="true" id="remember" name="remember" />
                            <label class="form-check-label small" for="remember">Remember me</label>
                        </div>
                        <a class="small" href="#">Forgot password?</a>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg">Sign in</button>
                    </div>
                </form>

                <div class="text-center muted-small">Authorized clinical staff only. Access is monitored.</div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
@{
}
