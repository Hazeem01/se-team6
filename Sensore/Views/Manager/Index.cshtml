@model Sensore.Models.Dashboard.ManagerDashboardVm
@using Sensore.Models.Dashboard

@{
    ViewData["Title"] = "Manager Dashboard";
}

<h2 class="mt-3 d-flex align-items-center gap-2">
    <span class="me-2">
        <i class="bi bi-bar-chart-fill"></i> 
    </span>
    @ViewData["Title"]
</h2>
<p class="text-muted">System overview and operational insights</p>

<div class="container mt-4">

    <div class="d-flex justify-content-end mb-3">
        <div class="btn-group" role="group">
            <a asp-action="Index" asp-route-period="today"
               class="btn btn-sm @(Model.SelectedPeriod == "today" ? "btn-primary" : "btn-outline-secondary")">
                Today
            </a>
     
        </div>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card h-100 border border-2">
                <div class="card-body">
                    <div class="text-muted small mb-1">
                        <i class="bi bi-people-fill me-1"></i> Total Patients
                    </div>
                    <div class="h3 mb-1">@Model.TotalPatients</div>
                    <div class="text-muted small">Active in system</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 border border-2">
                <div class="card-body">
                    <div class="text-muted small mb-1">
                        <i class="bi bi-activity me-1"></i> Care Team
                    </div>
                    <div class="h3 mb-1">@(@Model.TotalClinicians + @Model.TotalDoctors)</div>
                    <div class="text-muted small">
                        @Model.TotalClinicians clinicians, @Model.TotalDoctors doctors
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 border border-2 border-danger bg-danger-subtle">
                <div class="card-body">
                    <div class="small text-danger mb-1">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Critical Alerts
                    </div>
                    <div class="h3 mb-1 text-danger">@Model.CriticalAlerts</div>
                    <div class="small text-danger">
                        @Model.UnreviewedAlerts pending review
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100 border border-2 border-success bg-success-subtle">
                <div class="card-body">
                    <div class="small text-success mb-1">
                        <i class="bi bi-graph-up-arrow me-1"></i> Resolution Rate
                    </div>
                    <div class="h3 mb-1 text-success">@Model.ResolutionRate%</div>
                    <div class="small text-success">
                        @Model.ReviewedAlerts of @Model.TotalAlerts reviewed
                    </div>
                </div>
            </div>
        </div>

    </div>

    
    <div class="row g-4">
       
        <div class="col-lg-8">
            <div class="card border border-2">
                <div class="card-header">
                    <h5 class="card-title mb-0">System Performance</h5>
                </div>
                <div class="card-body">

                    <!-- Metrics Chart and Alert trend buttons -->
                   
                    <ul class="nav nav-tabs" id="perfTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="metrics-tab"
                                    data-bs-toggle="tab" data-bs-target="#metrics"
                                    type="button" role="tab">
                                Pressure Metrics
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="alerts-tab"
                                    data-bs-toggle="tab" data-bs-target="#alerts"
                                    type="button" role="tab">
                                Alert Trends
                            </button>
                        </li>
                    </ul>
                    <!-- Metrics chat model-->
                    <div class="tab-content mt-3" id="perfTabsContent">
                      
                        <div class="tab-pane fade show active" id="metrics" role="tabpanel">
                            @if (Model.Metrics != null && Model.Metrics.Any())
                            {
                                @await Html.PartialAsync("_MetricsChart", Model.Metrics)
                            }
                            else
                            {
                                <p class="text-muted small mb-0">No metrics data available.</p>
                            }
                        </div>

                       <!-- Alert trends cards -->
                        <div class="tab-pane fade" id="alerts" role="tabpanel">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="p-3 border border-2 border-danger bg-danger-subtle rounded-3">
                                        <div class="small text-danger">High Severity</div>
                                        <div class="h4 text-danger mt-1">
                                            @Model.AlertSeverity.High
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 border border-2 border-warning bg-warning-subtle rounded-3">
                                        <div class="small text-warning">Medium Severity</div>
                                        <div class="h4 text-warning mt-1">
                                            @Model.AlertSeverity.Medium
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 border border-2 border-success bg-success-subtle rounded-3">
                                        <div class="small text-success">Low Severity</div>
                                        <div class="h4 text-success mt-1">
                                            @Model.AlertSeverity.Low
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3 p-3 border border-2 rounded-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small">Average Response Time</span>
                                    <i class="bi bi-clock text-muted"></i>
                                </div>
                                <div class="h4 mb-0">@Model.AverageResponseHours.ToString("F1") hours</div>
                                <div class="small text-muted">
                                    From alert creation to review
                                </div>
                            </div>
                        </div>
                    </div>

                </div> 
            </div>
        </div>

       
        <div class="col-lg-4">
            <!-- High risk patients card -->
         
            <div class="card border border-2 border-danger mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0 text-danger">
                        <i class="bi bi-shield-exclamation me-1"></i>
                        High-Risk Patients
                    </h5>
                </div>
                <div class="card-body">
                    @if (!Model.HighRiskPatients.Any())
                    {
                        <div class="text-center py-4 text-muted small">
                            <i class="bi bi-check-circle text-success fs-2 d-block mb-2"></i>
                            No high-risk patients
                        </div>
                    }
                    else
                    {
                        @foreach (var patient in Model.HighRiskPatients.Take(5))
                        {
                            <div class="p-3 mb-2 border border-2 border-danger bg-danger-subtle rounded-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <div class="small fw-semibold">@patient.Name</div>
                                        <div class="small text-muted">
                                            @patient.UnreviewedAlertCount
                                            unreviewed alert@(patient.UnreviewedAlertCount > 1 ? "s" : "")
                                        </div>
                                    </div>
                                    <span class="badge bg-danger">HIGH</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!--Care Team status-->
          
            <div class="card border border-2">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-activity me-1"></i>
                        Care Team Status
                    </h5>
                </div>
                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center p-2 mb-2 border border-2 rounded-3">
                        <div>
                            <div class="small">Clinicians</div>
                            <div class="small text-muted">Active staff</div>
                        </div>
                        <div class="h4 mb-0">@Model.TotalClinicians</div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center p-2 mb-2 border border-2 rounded-3">
                        <div>
                            <div class="small">Doctors</div>
                            <div class="small text-muted">Medical team</div>
                        </div>
                        <div class="h4 mb-0">@Model.TotalDoctors</div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center p-2 border border-2 rounded-3">
                        <div>
                            <div class="small">Avg. Patient Load</div>
                            <div class="small text-muted">Per care provider</div>
                        </div>
                        <div class="h4 mb-0">
                            @{
                                var careTeamCount = Model.TotalClinicians + Model.TotalDoctors;
                                var avgLoad = careTeamCount == 0
                                ? 0
                                : (int)Math.Round((double)Model.TotalPatients / careTeamCount);
                            }
                            @avgLoad
                        </div>
                    </div>

                </div>
            </div>

        </div> 
    </div> 

</div> 
