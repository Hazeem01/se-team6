@using Sensore.Models.Dashboard
@{
    ViewData["Title"] = "Manager Dashboard";
    var metricsModel = ViewBag.Metrics as List<KeyMetricVm>;
}

<h2 class="mt-3">@ViewData["Title"]</h2>

<div class="container mt-4">

    <!-- ===== SUMMARY CARDS ROW ===== -->
    <div class="row g-3">

        <!-- Total Patients -->
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small mb-1">Total Patients</div>
                    <h3 class="mb-2">@ViewBag.TotalPatients</h3>
                    <div class="text-muted small">Active in system</div>
                </div>
            </div>
        </div>

        <!-- Care Team -->
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small mb-1">Care Team</div>
                    <h3 class="mb-2">
                        @( (int)ViewBag.TotalClinicians + (int)ViewBag.TotalDoctors )
                    </h3>
                    <div class="text-muted small">
                        @ViewBag.TotalClinicians clinicians,
                        @ViewBag.TotalDoctors doctors
                    </div>
                </div>
            </div>
        </div>

        <!-- Critical Alerts -->
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm" style="background:#fff5f5;">
                <div class="card-body d-flex flex-column">
                    <div class="text-danger small mb-1">Critical Alerts</div>
                    <h3 class="mb-2 text-danger">@ViewBag.TotalCriticalAlerts</h3>
                    <div class="text-danger small mb-3">
                        @ViewBag.PendingCriticalAlerts pending review
                    </div>

                    <!-- View All Alerts button -->
                    <div class="mt-auto">
                        <a asp-controller="Manager"
                           asp-action="Alerts"
                           class="btn btn-outline-danger btn-sm">
                            View all alerts
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Resolution Rate / Reports -->
        <div class="col-md-3">
            <div class="card h-100 border-0 shadow-sm" style="background:#f0fff4;">
                <div class="card-body d-flex flex-column">
                    <div class="text-success small mb-1">Resolution Rate</div>
                    <h3 class="mb-2 text-success">@ViewBag.ResolutionRate%</h3>
                    <div class="text-success small mb-3">
                        @ViewBag.ReviewedCritical of @ViewBag.TotalCriticalAlerts reviewed
                    </div>

                    <!-- Open Reports button -->
                    <div class="mt-auto">
                        <a asp-controller="Manager"
                           asp-action="Reports"
                           class="btn btn-outline-success btn-sm">
                            Open reports
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div> <!-- /row -->
    <!-- ===== METRICS CHART ROW ===== -->
    @if (metricsModel != null && metricsModel.Any())
    {
        <div class="row mt-5">
            <div class="col-12">
                @await Html.PartialAsync("_MetricsChart", metricsModel)
            </div>
        </div>
    }
    else
    {
        <div class="row mt-4">
            <div class="col-12">
                <p class="text-muted">No metrics data available.</p>
            </div>
        </div>
    }

</div>
