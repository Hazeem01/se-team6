@model Sensore.Models.Dashboard.ManagerDashboardVm
@using Sensore.Models.Dashboard
@using System.Text.Json

@{
    ViewData["Title"] = "Manager Dashboard";
}

<h2 class="mt-3 d-flex align-items-center gap-2">
    <i class="bi bi-bar-chart-fill"></i>
    @ViewData["Title"]
</h2>
<p class="text-muted">System overview and operational insights</p>

<div class="container mt-4">


    <div class="d-flex justify-content-end mb-3">
        <div class="btn-group" role="group">
            <a asp-action="Index" asp-route-period="today"
               class="btn btn-sm @(Model.SelectedPeriod == "today" ? "btn-primary" : "btn-outline-secondary")">
                Today
            </a>

            <a asp-action="Index" asp-route-period="week"
               class="btn btn-sm @(Model.SelectedPeriod == "week" ? "btn-primary" : "btn-outline-secondary")">
                This Week
            </a>

            <a asp-action="Index" asp-route-period="month"
               class="btn btn-sm @(Model.SelectedPeriod == "month" ? "btn-primary" : "btn-outline-secondary")">
                This Month
            </a>
        </div>
    </div>


   
    <div class="row g-3 mb-4">

      
        <div class="col-md-3">
            <div class="card h-100 border border-2">
                <div class="card-body">
                    <div class="text-muted small mb-1">
                        <i class="bi bi-people-fill me-1"></i> Total Patients
                    </div>
                    <div class="h3 mb-1">@Model.TotalPatients</div>
                    <div class="text-muted small">Active in system</div>
                </div>
            </div>
        </div>

      
        <div class="col-md-3">
            <div class="card h-100 border border-2">
                <div class="card-body">
                    <div class="text-muted small mb-1">
                        <i class="bi bi-activity me-1"></i> Care Team
                    </div>
                    <div class="h3 mb-1">
                        @(Model.TotalClinicians + Model.TotalDoctors)
                    </div>
                    <div class="text-muted small">
                        @Model.TotalClinicians clinicians, @Model.TotalDoctors doctors
                    </div>
                </div>
            </div>
        </div>

      
        <div class="col-md-3">
            <div class="card h-100 border border-2 border-danger bg-danger-subtle">
                <div class="card-body">
                    <div class="small text-danger mb-1">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Critical Alerts
                    </div>
                    <div class="h3 mb-1 text-danger">@Model.CriticalAlerts</div>
                    <div class="small text-danger">
                        @Model.UnreviewedAlerts pending review
                    </div>
                </div>
            </div>
        </div>

       
        <div class="col-md-3">
            <div class="card h-100 border border-2 border-success bg-success-subtle">
                <div class="card-body">
                    <div class="small text-success mb-1">
                        <i class="bi bi-graph-up-arrow me-1"></i> Resolution Rate
                    </div>
                    <div class="h3 mb-1 text-success">@Model.ResolutionRate%</div>
                    <div class="small text-success">
                        @Model.ReviewedAlerts of @Model.TotalAlerts reviewed
                    </div>
                </div>
            </div>
        </div>

    </div>

    
    <div class="row g-4">

        
        <div class="col-lg-8">
            <div class="card border border-2">
                <div class="card-header">
                    <h5 class="card-title mb-0">System Performance</h5>
                </div>

                <div class="card-body">

                   
                    <ul class="nav nav-tabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active"
                                    data-bs-toggle="tab"
                                    data-bs-target="#metrics"
                                    type="button">
                                Pressure Metrics
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link"
                                    data-bs-toggle="tab"
                                    data-bs-target="#alerts"
                                    type="button">
                                Alert Trends
                            </button>
                        </li>
                    </ul>

                 
                    <div class="tab-content mt-3">

                     
                        <div class="tab-pane fade show active" id="metrics">
                            @if (Model.Metrics != null && Model.Metrics.Any())
                            {
                                @await Html.PartialAsync("_MetricsChart", Model.Metrics)
                            }
                            else
                            {
                                <p class="text-muted small">No metrics data available.</p>
                            }
                        </div>

                     
                        <div class="tab-pane fade" id="alerts">
                            <div class="row g-3">

                                <div class="col-md-4">
                                    <div class="p-3 border border-2 border-danger bg-danger-subtle rounded-3">
                                        <div class="small text-danger">High Severity</div>
                                        <div class="h4 text-danger mt-1">
                                            @Model.AlertSeverity.High
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="p-3 border border-2 border-warning bg-warning-subtle rounded-3">
                                        <div class="small text-warning">Medium Severity</div>
                                        <div class="h4 text-warning mt-1">
                                            @Model.AlertSeverity.Medium
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="p-3 border border-2 border-success bg-success-subtle rounded-3">
                                        <div class="small text-success">Low Severity</div>
                                        <div class="h4 text-success mt-1">
                                            @Model.AlertSeverity.Low
                                        </div>
                                    </div>
                                </div>

                            </div>

                            <div class="mt-3 p-3 border border-2 rounded-3">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="small">Average Response Time</span>
                                    <i class="bi bi-clock text-muted"></i>
                                </div>
                                <div class="h4 mb-0">
                                    @Model.AverageResponseHours.ToString("F1") hours
                                </div>
                                <div class="small text-muted">
                                    From alert creation to review
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

      
        <div class="col-lg-4">

            
            <div class="card border border-2 border-danger mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0 text-danger">
                        <i class="bi bi-shield-exclamation me-1"></i>
                        High-Risk Patients
                    </h5>
                </div>

                <div class="card-body">
                    @if (!Model.HighRiskPatients.Any())
                    {
                        <div class="text-center py-4 text-muted small">
                            <i class="bi bi-check-circle text-success fs-2 d-block mb-2"></i>
                            No high-risk patients
                        </div>
                    }
                    else
                    {
                        @foreach (var patient in Model.HighRiskPatients.Take(5))
                        {
                            <div class="p-3 mb-2 border border-2 border-danger bg-danger-subtle rounded-3">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <div class="small fw-semibold">@patient.Name</div>
                                        <div class="small text-muted">
                                            @patient.UnreviewedAlertCount unreviewed alert(s)
                                        </div>
                                    </div>
                                    <span class="badge bg-danger">HIGH</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

          
            <div class="card border border-2">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-activity me-1"></i>
                        Care Team Status
                    </h5>
                </div>

                <div class="card-body">

                    <div class="d-flex justify-content-between p-2 mb-2 border border-2 rounded-3">
                        <div>
                            <div class="small">Clinicians</div>
                            <div class="small text-muted">Active staff</div>
                        </div>
                        <div class="h4 mb-0">@Model.TotalClinicians</div>
                    </div>

                    <div class="d-flex justify-content-between p-2 mb-2 border border-2 rounded-3">
                        <div>
                            <div class="small">Doctors</div>
                            <div class="small text-muted">Medical team</div>
                        </div>
                        <div class="h4 mb-0">@Model.TotalDoctors</div>
                    </div>

                    <div class="d-flex justify-content-between p-2 border border-2 rounded-3">
                        <div>
                            <div class="small">Avg. Patient Load</div>
                            <div class="small text-muted">Per care provider</div>
                        </div>
                        <div class="h4 mb-0">
                            @{
                                var careTeam = Model.TotalClinicians + Model.TotalDoctors;
                                var avgLoad = careTeam == 0
                                ? 0
                                : (int)Math.Round((double)Model.TotalPatients / careTeam);
                            }
                            @avgLoad
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        const metricsPoints = @Html.Raw(JsonSerializer.Serialize(
            (Model.Metrics ?? new List<KeyMetricVm>()).Select(m => new {
                time = m.Timestamp.ToLocalTime().ToString("HH:mm"),
                peak = Math.Round(m.PeakPressureIndex, 1),
                area = Math.Round(m.ContactAreaPercentage, 1)
            })
        ));

        console.log("metricsPoints:", metricsPoints);

        const canvas = document.getElementById("managerMetricsChart");
        if (!canvas) {
            console.error("Canvas #managerMetricsChart not found.");
        } else if (!metricsPoints || metricsPoints.length === 0) {
            console.warn("No metrics points.");
        } else {
            new Chart(canvas, {
                type: "line",
                data: {
                    labels: metricsPoints.map(p => p.time),
                    datasets: [
                        { label: "Peak Pressure", data: metricsPoints.map(p => p.peak), fill: true, tension: 0.35, pointRadius: 0 },
                        { label: "Contact Area %", data: metricsPoints.map(p => p.area), fill: true, tension: 0.35, pointRadius: 0, yAxisID: "y1" }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { position: "left" },
                        y1: { position: "right", grid: { drawOnChartArea: false } }
                    }
                }
            });
        }
    </script>
}