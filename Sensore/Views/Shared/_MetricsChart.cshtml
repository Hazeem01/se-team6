@using System.Text.Json
@using Sensore.Models.Dashboard
@model List<KeyMetricVm>

@{
 
    var points = Model.Select(m => new
    {
        time = m.Timestamp.ToString("HH:mm"),
        peak = Math.Round(m.PeakPressureIndex, 1),
        area = Math.Round(m.ContactAreaPercentage, 1)
    });

   
    var json = JsonSerializer.Serialize(points);
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h5 class="card-title mb-1">System Performance</h5>
        <p class="text-muted small mb-3">Pressure Metrics</p>

        <div style="height:260px;">
            <canvas id="managerMetricsChart"></canvas>
        </div>

        <div class="mt-2 text-center small">
            <span class="me-3">
                <span style="color:#3b82f6;">●</span> Contact Area %
            </span>
            <span>
                <span style="color:#ef4444;">●</span> Peak Pressure
            </span>
        </div>
    </div>
</div>
