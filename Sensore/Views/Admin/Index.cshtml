 @model Sensore.Models.Admin.AdminUsersVm

<h2>Admin - Users</h2>

<form method="get" class="form-inline mb-3">
    <select name="roleFilter" class="form-control mr-2">
        <option value="">All roles</option>
        @foreach (var r in Model.AvailableRoles)
        {
            <option value="@r">@r</option>
        }
    </select>
    <button class="btn btn-primary">Filter</button>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Email</th>
            <th>Roles</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model.Users)
        {
            <tr>
                <td>@u.Email</td>
                <td>@string.Join(", ", u.Roles)</td>
                <td>
                    <button class="btn btn-sm btn-secondary" data-toggle="collapse" data-target="#roles-@u.Id">Edit Roles</button>
                    <div class="collapse mt-2" id="roles-@u.Id">
                        <form method="post" asp-action="UpdateRoles">
                            <input type="hidden" name="userId" value="@u.Id" />
                            @foreach (var r in Model.AvailableRoles)
                            {
                                var isChecked = u.Roles.Contains(r);
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="selectedRoles" value="@r" id="@($"{u.Id}-{r}")" @(isChecked ? "checked" : "") />
                                    <label class="form-check-label" for="@($"{u.Id}-{r}")">@r</label>
                                </div>
                            }
                            <button class="btn btn-primary btn-sm mt-2">Save</button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<nav>
    <ul class="pagination">
        @for (int i = 1; i <= (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize); i++)
        {
            <li class="page-item @(i == Model.Page ? "active" : "")">
                <a class="page-link" href="?page=@i&pageSize=@Model.PageSize">@i</a>
            </li>
        }
    </ul>
</nav>
