@model Sensore.Models.Admin.AdminDashboardVm

@{
    ViewData["Title"] = "Admin Dashboard";
}

@*
    Admin Dashboard view.
    Model: AdminDashboardVm
    Responsibilities:
    - Display top-level KPIs for administrators.
    - Provide quick access links for user management and reporting.
    - Render a role breakdown chart powered by Chart.js.
*@

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="m-0">Admin Dashboard</h2>
    <div>
        <a class="btn btn-outline-secondary me-2" asp-controller="Admin" asp-action="Index"><i class="fa fa-users"></i> Manage Users</a>
        <a class="btn btn-primary" asp-controller="Admin" asp-action="Index"><i class="fa fa-user-plus me-1"></i> Create User</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-6 col-md-3">
        <div class="card text-white bg-primary h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-subtitle mb-2">Total Users</h6>
                    <h3 class="card-title display-6 m-0"><span class="kpi" data-target="@Model.TotalUsers">0</span></h3>
                </div>
                <div class="display-4 text-opacity-75"><i class="fa fa-users"></i></div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-subtitle mb-2">Clinicians</h6>
                    <h3 class="card-title display-6 m-0"><span class="kpi" data-target="@Model.ClinicianCount">0</span></h3>
                </div>
                <div class="display-4 text-muted"><i class="fa fa-user-md"></i></div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-subtitle mb-2">Patients</h6>
                    <h3 class="card-title display-6 m-0"><span class="kpi" data-target="@Model.PatientCount">0</span></h3>
                </div>
                <div class="display-4 text-muted"><i class="fa fa-procedures"></i></div>
            </div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="card h-100">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="card-subtitle mb-2">Active Alerts</h6>
                    <h3 class="card-title display-6 m-0"><span class="kpi" data-target="@Model.ActiveAlerts">0</span></h3>
                </div>
                <div class="display-4 text-danger"><i class="fa fa-exclamation-triangle"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title mb-0">Role Breakdown</h5>
                    <small class="text-muted">Live snapshot</small>
                </div>
                <canvas id="rolesChart" height="220"></canvas>
                <div class="mt-3">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">Admins <span class="badge bg-primary rounded-pill">@Model.AdminCount</span></li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">Doctors <span class="badge bg-secondary rounded-pill">@Model.DoctorCount</span></li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">Managers <span class="badge bg-success rounded-pill">@Model.ManagerCount</span></li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">Clinicians <span class="badge bg-info text-dark rounded-pill">@Model.ClinicianCount</span></li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">Patients <span class="badge bg-light text-dark rounded-pill">@Model.PatientCount</span></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Quick Actions</h5>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-primary" asp-controller="Admin" asp-action="Index"><i class="fa fa-users-cog me-1"></i> Manage Users</a>
                    <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Create"><i class="fa fa-user-plus me-1"></i> Create User</a>
                    <a class="btn btn-outline-secondary" href="#"><i class="fa fa-file-export me-1"></i> Export CSV</a>
                    <a class="btn btn-outline-secondary" href="#"><i class="fa fa-chart-line me-1"></i> View Reports</a>
                </div>

                <hr />
                <h6 class="mt-3">Recent activity</h6>
                <p class="text-muted">No recent activity available. Use the Manage Users page to audit accounts and assignments.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.querySelectorAll('.kpi').forEach(function(el) {
            const target = parseInt(el.getAttribute('data-target') || '0', 10);
            let current = 0;
            const duration = 900;
            const stepTime = Math.max(10, Math.floor(duration / Math.max(1, target)));
            const timer = setInterval(function() {
                current += Math.max(1, Math.floor(target / (duration / stepTime)));
                if (current >= target) {
                    el.textContent = target;
                    clearInterval(timer);
                } else {
                    el.textContent = current;
                }
            }, stepTime);
        });

        (function() {
            const ctx = document.getElementById('rolesChart').getContext('2d');
            const data = {
                labels: ['Admins', 'Doctors', 'Managers', 'Clinicians', 'Patients'],
                datasets: [{
                    data: [@Model.AdminCount, @Model.DoctorCount, @Model.ManagerCount, @Model.ClinicianCount, @Model.PatientCount],
                    backgroundColor: ['#6c5ce7', '#95a5a6', '#00b894', '#00a8ff', '#f6c85f']
                }]
            };

            new Chart(ctx, {
                type: 'doughnut',
                data: data,
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        })();
    </script>
}
